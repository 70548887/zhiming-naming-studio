          "heteronym": {
            "index": 0,
            "path": "/122400/heteronyms/0",
            "sha256": "ae687635efcc4f53ebdadf9a23326d181584fe628c32c2f20a715442915875fb",
            "rawPinyin": "ruò",
            "rawBopomofo": "ㄖㄨㄛˋ"
          },
          "pinyin": "ruò",
          "tone": 4,
          "label": null,
          "isCurrentDefault": true,
          "definitions": [
            {
              "definitionId": "cmnd1-a42de53fe1be9d8ecce0cf0f3a87423e6e87a7bd13000377254b580a0d0846f9",
              "path": "/122400/heteronyms/0/definitions/0",
              "index": 0,
              "original": {
                "def": "一種香草。",
                "quote": [
                  "《楚辭．屈原．九章．惜往日》：「自前世之嫉賢兮，謂蕙若其不可佩。」",
                  "唐．陸龜蒙〈美人〉詩：「猶欲悟君心，朝朝佩蘭若。」"
                ],
                "type": "名"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-3c40998b856f1cfa694c548a10d4a61cb2271f8541e1a821fb20372b74051c98",
              "path": "/122400/heteronyms/0/definitions/1",
              "index": 1,
              "original": {
                "def": "姓。如漢代有若章。",
                "type": "名"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-b2c74a577da7046023c7f505f8e2f0290baa76072bc1a01854f19c4edbd2b1e8",
              "path": "/122400/heteronyms/0/definitions/2",
              "index": 2,
              "original": {
                "def": "順從。",
                "quote": [
                  "《左傳．宣公三年》：「故民入川澤山林，不逢不若。」"
                ],
                "type": "動"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-32641be37dad2281a9b74213da7b45be2c178935e9bf0b8eef016cfcba33d6ac",
              "path": "/122400/heteronyms/0/definitions/3",
              "index": 3,
              "original": {
                "def": "及、比得上。",
                "quote": [
                  "《國語．晉語五》：「病未若死，祗以解志。」",
                  "《論語．學而》：「未若貧而樂，富而好禮者也。」"
                ],
                "type": "動"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-3b114ca891d1a00cf479ff1e6bf9078ddeab10b43e056dea590de4e695d538f6",
              "path": "/122400/heteronyms/0/definitions/4",
              "index": 4,
              "original": {
                "def": "奈。",
                "quote": [
                  "《左傳．僖公十五年》：「寇深矣，若之何？」"
                ],
                "type": "動"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-49064e0651def02fd230a725a6c0ac33bca46a60b3afc82cc2e3f9e6305b9ceb",
              "path": "/122400/heteronyms/0/definitions/5",
              "index": 5,
              "original": {
                "def": "如果、假如，表示假設。",
                "quote": [
                  "《左傳．僖公二十三年》：「公子若反晉國，則何以報不穀？」",
                  "唐．李賀〈金銅仙人辭漢歌〉：「天若有情天亦老，攜盤獨出月荒涼。」"
                ],
                "type": "連"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-96d1781b1683c1993c2fc4d1411fc70be259a9bac9b22d8c83b9f49bf851ea76",
              "path": "/122400/heteronyms/0/definitions/6",
              "index": 6,
              "original": {
                "def": "至於，表示另提一件事。",
                "quote": [
                  "《孟子．梁惠王上》：「若民，則無恆產因無恆心。」",
                  "《荀子．勸學》：「故學數有終，若其義則不可須臾舍也。」"
                ],
                "type": "連"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-0bac8f7c809454c2d74fb596656497406fb17d74c8964c5dbb51f1715456fda4",
              "path": "/122400/heteronyms/0/definitions/7",
              "index": 7,
              "original": {
                "def": "或、或者，表示選擇。",
                "quote": [
                  "《史記．卷一○七．魏其武安侯傳》：「願取吳王若將軍頭，以報父之仇。」",
                  "《紅樓夢．第七四回》：「將鏡奩、妝盒、衾袱、衣包若大若小之物，一齊打開。」"
                ],
                "type": "連"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-0e392bcc8c8b61bbd01cf81ae70a1cc280ca58a70c18e095983c989be43b4851",
              "path": "/122400/heteronyms/0/definitions/8",
              "index": 8,
              "original": {
                "def": "乃、才。",
                "quote": [
                  "《國語．周語中》：「必有忍也，若能有濟也。」"
                ],
                "type": "副"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-b9085d05087597f57db7a8aa2ae215f2663849895c0796b9487f33b979547674",
              "path": "/122400/heteronyms/0/definitions/9",
              "index": 9,
              "original": {
                "def": "似、好像。",
                "example": [
                  "如：「欣喜若狂」、「旁若無人」。"
                ],
                "quote": [
                  "《左傳．定公四年》：「若聞蔡將先衛，信乎？」",
                  "明．李時珍《本草綱目．卷四九．禽部．杜鵑》：「其鳴若曰：『不如歸去。』」"
                ],
                "type": "副"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-c20531ceb939700862c578b09794192bd6ab88a495c2f9a91d67a31483e26849",
              "path": "/122400/heteronyms/0/definitions/10",
              "index": 10,
              "original": {
                "def": "你、你的。",
                "quote": [
                  "《莊子．齊物論》：「然則我與若與人俱不能相知也。」",
                  "《史記．卷七．項羽本紀》：「吾翁即若翁，必欲烹而翁，則幸分我一杯羹。」"
                ],
                "type": "代"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-e61ffab1d1260688659812ef1c61ffcc9629c9e112d38614e80c397227a0b162",
              "path": "/122400/heteronyms/0/definitions/11",
              "index": 11,
              "original": {
                "def": "如此、這樣。",
                "quote": [
                  "《書經．大誥》：「爾知寧王若勤哉？」",
                  "唐．白居易〈見敏中初到邠寧秋日登城樓詩詩中頗多鄉思因以寄和〉詩：「望鄉心若苦，不用數登樓。」"
                ],
                "type": "代"
              },
              "kind": "definition"
            }
          ],
          "suitabilityForPersonalName": "not-assessed"
        },
