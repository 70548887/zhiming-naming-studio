          "label": null,
          "isCurrentDefault": true,
          "definitions": [
            {
              "definitionId": "cmnd1-8f08409f2d079884c2dd1949b79559625b37493a5b290f388af34a9cf75b0196",
              "path": "/126201/heteronyms/0/definitions/0",
              "index": 0,
              "original": {
                "def": "植物名：(1)一種葉細長而尖，花有清香味的多年生草本植物。參見「蘭花」條。(2) 蘭草、澤蘭。菊科蘭澤屬，多年生草本。葉卵形，對生，邊緣有鋸齒。秋末開花，全株有香味，可供觀賞。古人所謂蘭多指此草。",
                "quote": [
                  "《漢書．卷五七．司馬相如傳上》：「其東則有蕙圃，衡蘭芷若。」",
                  "唐．顏師古．注：「蘭，即今所澤蘭也。」"
                ],
                "type": "名"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-f8547f54c1b7e81f587b7c2003b46c7b697735924c6b377aaa9ba72f6d92eec8",
              "path": "/126201/heteronyms/0/definitions/1",
              "index": 1,
              "original": {
                "def": "姓。如漢代有蘭廣。",
                "type": "名"
              },
              "kind": "definition"
            }
          ],
          "suitabilityForPersonalName": "not-assessed"
        }
