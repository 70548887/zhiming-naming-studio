            "rawPinyin": "zhī",
            "rawBopomofo": "ㄓ"
          },
          "pinyin": "zhī",
          "tone": 1,
          "label": null,
          "isCurrentDefault": true,
          "definitions": [
            {
              "definitionId": "cmnd1-d9adacb54be674c1dd4eb3797e6427e001a03d691a097c743d78963e4c1343da",
              "path": "/103895/heteronyms/0/definitions/0",
              "index": 0,
              "original": {
                "def": "明白、了解、察覺。",
                "example": [
                  "如：「相知相許」。"
                ],
                "quote": [
                  "唐．李紳〈古風〉詩二首之二：「誰知盤中餐，粒粒皆辛苦。」"
                ],
                "type": "動"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-751060a3dc6a021f47757d0776771c553718e7c29efc03d8eb55686b6df9dd63",
              "path": "/103895/heteronyms/0/definitions/1",
              "index": 1,
              "original": {
                "def": "識別、區別。",
                "quote": [
                  "《禮記．樂記》：「知樂則幾於禮矣。」",
                  "《淮南子．脩務》：「孿子之相似者，唯其母能知之。」"
                ],
                "type": "動"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-e3f1a590ad496177a92b0b4af2e2ff9d34e25f896a36a99178ee96e01729adbe",
              "path": "/103895/heteronyms/0/definitions/2",
              "index": 2,
              "original": {
                "def": "相交、交往。",
                "quote": [
                  "《左傳．昭公四年》：「公孫明知叔孫於齊。」",
                  "《荀子．不苟》：「君子易知而難狎。」"
                ],
                "type": "動"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-12f0e4a710e951ba6a23db5da8008ccc8b1894d51ff49c1d1914a1f43236b7fd",
              "path": "/103895/heteronyms/0/definitions/3",
              "index": 3,
              "original": {
                "def": "招待、禮遇、賞識。",
                "quote": [
                  "《南史．卷一九．謝靈運傳》：「自謂才能宜參權要，既不見知，常懷慎惋。」",
                  "唐．岑參〈北庭西郊候封大夫受降回軍獻上〉詩：「何幸一書生，忽蒙國士知。」"
                ],
                "type": "動"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-0e7afda3cb0e7d9170d347b64070cbec3ec6f92d451872b4e7353f109383a5d9",
              "path": "/103895/heteronyms/0/definitions/4",
              "index": 4,
              "original": {
                "def": "掌管、主持。",
                "quote": [
                  "《國語．越語》：「有能助寡人謀而退吳者，吾與之共知越國之政。」",
                  "《新唐書．卷八五．王世充傳》：「帝愛昵之，拜江都通守，兼知宮監事。」"
                ],
                "type": "動"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-8542aa9f7093e1e0f2081d65fe23804f4ecbb534bff90f76626c8e42b246e0b2",
              "path": "/103895/heteronyms/0/definitions/5",
              "index": 5,
              "original": {
                "def": "識見、學問。",
                "example": [
                  "如：「求知」、「真知灼見」。"
                ],
                "quote": [
                  "《論語．子罕》：「吾有知乎哉？無知也。」"
                ],
                "type": "名"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-1e3ecdfb59ee94183735c036c9a6e3532249e98a6421aa3f99ceddbb0f21d251",
              "path": "/103895/heteronyms/0/definitions/6",
              "index": 6,
              "original": {
                "def": "意識、感覺。",
                "quote": [
                  "《荀子．王制》：「草木有生而無知。」",
                  "漢．范縝〈神滅論〉：「手等亦應能有痛癢之知。」"
                ],
                "type": "名"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-92e0e2e95022cdc425f17351073256223f806fb5576becb9fd6bcd64c1305daf",
              "path": "/103895/heteronyms/0/definitions/7",
              "index": 7,
              "original": {
                "def": "知己、朋友。",
                "example": [
                  "如：「故知」、「舊雨新知」。"
                ],
                "type": "名"
              },
              "kind": "definition"
            }
          ],
          "suitabilityForPersonalName": "not-assessed"
        },
