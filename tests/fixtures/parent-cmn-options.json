              "path": "/103895/heteronyms/1/definitions/0",
              "index": 0,
              "original": {
                "def": "智慧。",
                "link": [
                  "同「智」。"
                ],
                "quote": [
                  "《論語．里仁》：「里仁為美，擇不處仁焉得知？」",
                  "《禮記．中庸》：「知仁勇三者，天下之達德也。」"
                ],
                "type": "名"
              },
              "kind": "definition"
            },
            {
              "definitionId": "cmnd1-c7d3a6fba6a0da69dd7c1ddd9d43664355f407d927337e719c49161eef381679",
              "path": "/103895/heteronyms/1/definitions/1",
              "index": 1,
              "original": {
                "def": "姓。如春秋時晉國有知罃。",
                "type": "名"
              },
              "kind": "definition"
            }
          ],
          "suitabilityForPersonalName": "not-assessed"
        }
