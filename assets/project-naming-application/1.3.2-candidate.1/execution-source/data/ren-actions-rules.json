{
  "version": "1.0.0",
  "profileId": "ren-source-conditional-actions/1.0.0",
  "sourceId": "bazi-ditian-ren-actions-2600158",
  "source": {
    "revision": 2600158,
    "title": "滴天髓闡微",
    "authority": "ren-commentary",
    "fullWikitextSha256": "1d1a3d61c1b9a26618b41b8ead857a6b966992fdf2adabdc607a0c6cb4c8f04d",
    "fullWikitextCodepoints": 143701,
    "url": "https://zh.wikisource.org/w/index.php?title=%E6%BB%B4%E5%A4%A9%E9%AB%93%E9%97%A1%E5%BE%AE&oldid=2600158"
  },
  "clauses": [
    {
      "id": "element-identity",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 七、天干",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "甲乙一木也，丙丁一火也，戊己一土也，庚辛一金也，壬癸一水也，即分别所用，不过阳刚阴柔，阳健阴顺而已。",
      "locator": "oldid=2600158;codepoint[4772,4822)",
      "sourceSpan": {
        "start": 4772,
        "end": 4822,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-1",
      "scope": "五行成员同类不等于作用相同或强弱已定。"
    },
    {
      "id": "root-presence",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "人之日主不必生逢禄旺，即月令休囚，而年日时中，得长生禄旺，便不为弱，就使逢库，亦为有根。",
      "locator": "oldid=2600158;codepoint[14913,14957)",
      "sourceSpan": {
        "start": 14913,
        "end": 14957,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-2",
      "scope": "有根词汇与条件原句；实际有效支撑仍需冲克救应。"
    },
    {
      "id": "yin-no-birth",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "古人取格，丁遇酉以财论，乙遇午、己遇酉、辛遇子、癸遇卯，以食神泄气论，俱不以生论。",
      "locator": "oldid=2600158;codepoint[15143,15184)",
      "sourceSpan": {
        "start": 15143,
        "end": 15184,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-2",
      "scope": "拒绝这些配对的阴干逆十二运生地作为唯一有效生扶证据。"
    },
    {
      "id": "yin-no-death",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "乙遇亥、癸遇申以印论，倶不以死论。即己遇寅岁之丙火，辛遇巳藏之戊土，亦以印论，不以死论。",
      "locator": "oldid=2600158;codepoint[15184,15228)",
      "sourceSpan": {
        "start": 15184,
        "end": 15228,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-2",
      "scope": "后两例必须定位具体藏丙/戊；不由死标签注销印或根。"
    },
    {
      "id": "yin-same-lifecycle",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "由此观之，阴阳同生同死可知也，若执定阴阳顺逆，而以阳生阴死，阴生阳死论命，则大谬矣。",
      "locator": "oldid=2600158;codepoint[15228,15270)",
      "sourceSpan": {
        "start": 15228,
        "end": 15270,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-2",
      "scope": "固定任注反对以逆十二运独证生死，不禁止其他流派显示。"
    },
    {
      "id": "wood-carried",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "如喜甲乙，而载以寅卯亥子，则生旺，载以申酉，则克败矣；",
      "locator": "oldid=2600158;codepoint[15723,15750)",
      "sourceSpan": {
        "start": 15723,
        "end": 15750,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-3",
      "scope": "仅明干甲乙与同柱所载列举支；喜忌未核，不产吉凶。"
    },
    {
      "id": "fire-carried",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "忌丙丁，载以亥子则制伏，载以巳午寅卯，则肆逞矣。",
      "locator": "oldid=2600158;codepoint[15750,15774)",
      "sourceSpan": {
        "start": 15750,
        "end": 15774,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-3",
      "scope": "仅明干丙丁与同柱列举支；忌神前提保留未知。"
    },
    {
      "id": "wood-covered",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "如喜寅卯，而覆以甲乙壬癸则生旺，覆以庚辛，则克败矣；",
      "locator": "oldid=2600158;codepoint[15774,15800)",
      "sourceSpan": {
        "start": 15774,
        "end": 15800,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-3",
      "scope": "仅寅卯支与其同柱覆干；不泛化所有支。"
    },
    {
      "id": "fire-covered",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "忌巳午，而覆以壬癸则制伏，覆以丙丁甲乙，是肆逞矣。",
      "locator": "oldid=2600158;codepoint[15800,15825)",
      "sourceSpan": {
        "start": 15800,
        "end": 15825,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-3",
      "scope": "仅巳午支与其同柱覆干；不作实际制伏充分条件。"
    },
    {
      "id": "root-support-damage",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 九、干支总论",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "干通根于支，支逢生扶，则干之根坚，支逢冲克，则干之根拔矣。",
      "locator": "oldid=2600158;codepoint[15830,15859)",
      "sourceSpan": {
        "start": 15830,
        "end": 15859,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-3",
      "scope": "根受作用的条件后果，冲克有力和救应另外求证，不删节点。"
    },
    {
      "id": "root-store-vocabulary",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 十七、衰旺",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "墓者，如甲乙逢未，丙丁逢戌，庚辛逢丑，壬癸辰之类是也。",
      "locator": "oldid=2600158;codepoint[40730,40757)",
      "sourceSpan": {
        "start": 40730,
        "end": 40757,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-4",
      "scope": "固定电子壬癸辰原字保留；四元素墓库词汇，不移阴干逆序。"
    },
    {
      "id": "root-residue-vocabulary",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 十七、衰旺",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "余气者，如丙丁逢未，甲乙逢辰，庚辛逢戌，壬癸逢丑之类是也，",
      "locator": "oldid=2600158;codepoint[40786,40815)",
      "sourceSpan": {
        "start": 40786,
        "end": 40815,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-4",
      "scope": "仅该明确完整余气句，前文重复疑文仍在上下文原样保留。"
    },
    {
      "id": "root-growth-vocabulary",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 十七、衰旺",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "得二比肩，不如支中得一长生禄旺，如甲乙逢亥寅卯之类是也。",
      "locator": "oldid=2600158;codepoint[40815,40843)",
      "sourceSpan": {
        "start": 40815,
        "end": 40843,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-4",
      "scope": "只对原文明列木亥寅卯标重根类；其他元素不能偷借逆十二运填表。"
    },
    {
      "id": "clash-power",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 八、地支",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "得令者冲衰则拔，失时者冲旺无伤。冲之者有力，则能去之",
      "locator": "oldid=2600158;codepoint[13638,13664)",
      "sourceSpan": {
        "start": 13638,
        "end": 13664,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-5",
      "scope": "能力前提不能由单一月支相等自证。"
    },
    {
      "id": "clash-rescue",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 八、地支",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "必先察其衰旺，四柱有无解救，或抑冲，或助泄，观其大势，究其喜忌",
      "locator": "oldid=2600158;codepoint[13968,13999)",
      "sourceSpan": {
        "start": 13968,
        "end": 13999,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-5",
      "scope": "冲克先审能力/救应，不由冲字成员直接拔根。"
    },
    {
      "id": "wood-triad-internal",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 十一、方局",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "凡会忌冲，如亥卯未木局，杂一酉丑字于其中，而以与所冲之神紧贴，是为破局。",
      "locator": "oldid=2600158;codepoint[29425,29461)",
      "sourceSpan": {
        "start": 29425,
        "end": 29461,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-6",
      "scope": "限定完整木局内部相邻酉卯/丑未的结构条文，不转实际拔根。"
    },
    {
      "id": "wood-triad-boundary",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 十一、方局",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "虽冲字杂地其中，而不紧贴，或冲字处于其外而紧贴，则会局与损局瘐论",
      "locator": "oldid=2600158;codepoint[29461,29493)",
      "sourceSpan": {
        "start": 29461,
        "end": 29493,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-6",
      "scope": "瘐疑字保留；外部/内部不贴仅待核，不当作无损。"
    },
    {
      "id": "resource-rescue",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 二十、通关",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "局内有印，被财星损坏，或官星化之，或比劫解之，或被合住，则冲开之，或被冲坏，则合化之，或隔一物，则克去-之",
      "locator": "oldid=2600158;codepoint[47388,47441)",
      "sourceSpan": {
        "start": 47388,
        "end": 47441,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-7",
      "scope": "财伤印与官桥/比劫救的同靶子路径；未实现合冲解救的全部先后。"
    },
    {
      "id": "bridge-isolation",
      "sourceId": "bazi-ditian-ren-actions-2600158",
      "section": "通神论 二十、通关",
      "layer": "ren-commentary;source-conditional-structural-prerequisite",
      "quote": "如年印时杀，干杀支印，前后远立，上下悬隔，或为间神忌物所间，此原局无可通之理",
      "locator": "oldid=2600158;codepoint[47460,47498)",
      "sourceSpan": {
        "start": 47460,
        "end": 47498,
        "unit": "unicode-codepoint",
        "interval": "[start,end)"
      },
      "contextId": "context-7",
      "scope": "保留层位/隔神必要审察，不把远隔统一当无效。"
    }
  ],
