      "verbatimEntry": {
        "heteronyms": [
          {
            "bopomofo": "ㄈㄥ",
            "definitions": [
              {
                "def": "植物名。金縷梅科楓香屬，落葉大喬木。葉互生，菱形，掌狀分裂為三，邊緣有細鋸齒。單性花，雌雄同株。春季抽新葉並開黃褐色花。蒴果集生。木材可供建築箱櫃之用。秋間葉落前，葉色由黃而紅，甚為美觀，故常栽培為庭園樹。",
                "link": [
                  "俗稱為「楓樹」。"
                ],
                "type": "名"
              }
            ],
            "pinyin": "fēng"
          }
        ],
        "non_radical_stroke_count": 9,
        "radical": "木",
        "stroke_count": 13,
        "title": "楓"
      }
    },
