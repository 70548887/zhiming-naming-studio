      "sourceDefinitionSha256": "7f252b873a93f73350d8e32cae06629a61f51282f3333f2564f16dd8d317c9c1",
      "rawPinyin": "zhī",
      "glyphEvidence": [],
      "verbatimEntry": {
        "heteronyms": [
          {
            "bopomofo": "ㄓ",
            "definitions": [
              {
                "def": "樹幹從旁生出的枝條。",
                "example": [
                  "如：「枯枝」、「嫩枝」。"
                ],
                "quote": [
                  "《說文解字．木部》：「枝，木別生條也。」"
                ],
                "type": "名"
              },
              {
                "def": "凡自同一本源而分出者。",
                "quote": [
                  "《左傳．莊公六年》：「《詩》云：『本枝百世。』」",
                  "《荀子．儒效》：「故以枝代主而非越也。」"
                ],
                "type": "名"
              },
              {
                "def": "四肢。",
                "link": [
                  "通「肢」。"
                ],
                "quote": [
                  "《莊子．大宗師》：「墮枝體，黜聰明，離形去知。」"
                ],
                "type": "名"
              },
              {
                "def": "量詞。計算細長物體的單位。",
                "example": [
                  "如：「一枝花」、「三枝毛筆」。"
                ],
                "type": "名"
              },
              {
                "def": "姓。如漢代有枝百英。",
                "type": "名"
              },
              {
                "def": "不中肯的、不一致的。",
                "quote": [
                  "《易經．繫辭下》：「中心疑者，其辭枝。」"
                ],
                "type": "形"
              }
            ],
            "pinyin": "zhī"
          },
          {
            "bopomofo": "ㄑㄧˊ",
            "definitions": [
              {
                "def": "多出的腳趾。",
                "example": [
                  "如：「駢拇枝指」。"
                ],
                "link": [
                  "同「跂」。"
                ],
                "quote": [
                  "《集韻．平聲．支韻》：「跂，《說文》：『足多指也。』或作枝。」"
                ],
                "type": "名"
              }
            ],
            "pinyin": "qí"
          }
        ],
        "non_radical_stroke_count": 4,
        "radical": "木",
        "stroke_count": 8,
        "title": "枝"
      }
    },
