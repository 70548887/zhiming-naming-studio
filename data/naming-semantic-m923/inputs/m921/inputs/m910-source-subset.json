      "rawHeteronymIndex": 0,
      "rawDefinitionIndex": 0,
      "sourceDefinition": {
        "def": "平穩、安全、舒適的狀況或環境。",
        "example": [
          "如：「居安思危」、「轉危為安」、「苟且偷安」。"
        ],
        "quote": [
          "《論語．學而》：「君子食無求飽，居無求安。」"
        ],
        "type": "名"
      },
      "completeOriginalEntry": {
        "heteronyms": [
          {
            "bopomofo": "ㄢ",
            "definitions": [
              {
                "def": "平穩、安全、舒適的狀況或環境。",
                "example": [
                  "如：「居安思危」、「轉危為安」、「苟且偷安」。"
                ],
                "quote": [
                  "《論語．學而》：「君子食無求飽，居無求安。」"
                ],
                "type": "名"
              },
              {
                "def": "安非他命的簡稱。",
                "example": [
                  "如：「吸安」、「安毒」。"
                ],
                "type": "名"
              },
              {
                "def": "量詞。安培的簡稱。參見「安培」條。",
                "type": "名"
              },
              {
                "def": "姓。如漢代有安成。",
                "type": "名"
              },
              {
                "def": "平靜、恬適。",
                "example": [
                  "如：「安寧」、「坐立不安」。"
                ],
                "quote": [
                  "《漢書．卷六四下．嚴安傳》：「心既和平，其性恬安。」"
                ],
                "type": "形"
              },
              {
                "def": "穩定的、靜止的。",
                "example": [
                  "如：「生活安穩」。"
                ],
                "quote": [
                  "唐．楊烱〈渾天賦〉：「故知天常安而不動，地極深而不測。」"
                ],
                "type": "形"
              },
              {
                "def": "使穩定。",
                "example": [
                  "如：「除暴安良」、「安民」。"
                ],
                "type": "動"
              },
              {
                "def": "裝置、設置。",
                "example": [
                  "如：「安電燈」、「安門窗」。"
                ],
                "type": "動"
              },
              {
                "def": "加上。",
                "example": [
                  "如：「安罪名」。"
                ],
                "type": "動"
              },
              {
                "def": "存、懷、居。",
                "example": [
                  "如：「你安的是什麼心？」"
                ],
                "type": "動"
              },
              {
                "def": "習慣、熟悉。",
                "quote": [
                  "《呂氏春秋．先識覽．樂成》：「舟車之始見也，三世然後安之。」"
                ],
                "type": "動"
              },
              {
                "def": "豈、怎麼。用於文言文。",
                "example": [
                  "如：「安能如此？」"
                ],
                "quote": [
                  "《左傳．宣公十二年》：「暴而不戢，安能保大？」"
                ],
                "type": "副"
              },
              {
                "def": "何處、那裡。用於文言文。",
                "example": [
                  "如：「而今安在？」"
                ],
                "quote": [
                  "《史記．卷七．項羽本紀》：「項王曰：『沛公安在？』良曰：『聞大王有意督過之，脫身獨去，已至軍矣。』」"
                ],
                "type": "代"
              },
              {
                "def": "如何。",
                "quote": [
                  "《禮記．檀弓上》：「泰山其頹，則吾將安仰？」"
                ],
                "type": "代"
              },
              {
                "def": "乃、於是。",
                "quote": [
                  "《荀子．仲尼》：「委然成文，以示之天下，而暴國安自化矣。」"
                ],
                "type": "連"
              }
            ],
            "pinyin": "ān"
          }
        ],
