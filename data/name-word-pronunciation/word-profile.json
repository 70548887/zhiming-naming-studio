      "originalPinyin": "ān níng",
      "definitions": [
        {
          "antonyms": "煩悶,煩惱,煩擾,煩躁,紛擾,動亂,混亂,攪擾,騷擾,厭煩",
          "def": "安定平靜。",
          "quote": [
            "《漢書．卷八三．朱博傳》：「部刺史奉使典州，督察郡國吏民安寧。」",
            "《紅樓夢．第七九回》：「自己身上分去責任，到底比這樣安寧些。」"
          ],
          "synonyms": "寧靜,和平,安定,安好,安閒,安詳,安適"
        },
        {
          "def": "冬天。",
          "quote": [
            "《爾雅．釋天》：「秋為收成，冬為安寧。」"
          ]
        },
        {
          "def": "縣名。在雲南省昆明市西南，滇池西北。"
        }
      ],
