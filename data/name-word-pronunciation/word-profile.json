      "definitions": [
        {
          "antonyms": "紛擾",
          "def": "安定平和。",
          "quote": [
            "《書經．周官》：「司徒掌邦教，敷五典，擾兆民。」",
            "唐．孔穎達．正義：「司徒主國教化，布五常之教，以安和天下眾民。」",
            "唐．元結〈夏侯岳州表〉：「公能請正寬恕，靜以理之，故其人安和而服悅，為當時法則。」"
          ]
        },
        {
          "def": "安好、平安。",
          "quote": [
            "唐．韓愈〈與大顛師書〉：「孟夏漸熱，惟道體安和。」"
          ]
        }
      ],
